{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@stylistic/eslint-plugin"],
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "node", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true,
    "node": true
  },
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "ignorePatterns": ["dist/", "test/fixtures/", "test/corpus/"],
  "rules": {
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",
    "prefer-template": "warn",
    "object-shorthand": "warn",
    "no-console": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "no-shadow": "off",
    "no-await-in-loop": "off",

    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "inline-type-imports", "disallowTypeAnnotations": false }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "off",

    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/first": "error",

    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-useless-spread": "warn",
    "unicorn/prefer-string-slice": "warn",
    "unicorn/prefer-at": "warn",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",

    "@stylistic/padding-line-between-statements": ["error", { "blankLine": "always", "prev": "*", "next": "return" }]
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "max-classes-per-file": ["error", 0],
        "func-style": ["error", "declaration"],
        "typescript/explicit-function-return-type": ["error", { "allowExpressions": true }]
      }
    },
    {
      "files": ["scripts/**", ".release-it.js"],
      "rules": {
        "no-console": "off",
        "typescript/no-misused-spread": "off"
      }
    },
    {
      "files": ["test/**"],
      "rules": { "typescript/no-floating-promises": "off" }
    }
  ]
}
