{
  "name": "@beardcoder/prettier-plugin-fluid",
  "version": "0.11.1",
  "description": "Prettier plugin for TYPO3 Fluid templates that plays nicely with other HTML plugins",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "typo3",
    "fluid",
    "fluid-templates",
    "formatter"
  ],
  "homepage": "https://github.com/beardcoder/prettier-plugin-fluid#readme",
  "bugs": {
    "url": "https://github.com/beardcoder/prettier-plugin-fluid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beardcoder/prettier-plugin-fluid.git"
  },
  "license": "MIT",
  "author": "Markus Sommer (https://github.com/beardcoder)",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "bun run typecheck && bun run format:check && bun test && bun run corpus:strict",
    "corpus": "bun scripts/check-corpus.js",
    "corpus:strict": "bun scripts/check-corpus.js --strict test/corpus",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "prepublishOnly": "bun run check",
    "release": "release-it",
    "test": "bun test",
    "test:node": "node --test",
    "test:package": "node scripts/check-package.js",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@release-it/conventional-changelog": "^12.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "release-it": "^21.1.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.2"
}
